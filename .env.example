# ========================================================
# ResearchGraph AI - Environment Configuration Template
# ========================================================

# -----------------
# Core Application
# -----------------
PROJECT_NAME="ResearchGraph AI"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api
PORT=8000
HOST=127.0.0.1

# -----------------
# Security & JWT Auth
# -----------------
SECRET_KEY=change_me_to_a_secure_random_64_character_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# -----------------
# Database Configuration
# -----------------
# Default zero-dependency local SQLite async configuration:
DATABASE_URL=sqlite+aiosqlite:///./researchgraph.db

# Optional Managed PostgreSQL (Uncomment for production):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/researchgraph

# -----------------
# Vector Database (Qdrant)
# -----------------
# Leave empty to utilize high-performance in-memory TF-IDF + Random Projection engine
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# -----------------
# Graph Database (Neo4j)
# -----------------
# Leave empty to utilize in-memory NetworkX Graph Engine with Dijkstra & PageRank
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# -----------------
# Cache & Task Queue (Redis)
# -----------------
REDIS_URL=redis://localhost:6379/0

# -----------------
# Academic Data Source APIs (Optional - Graceful Fallbacks Included)
# -----------------
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# -----------------
# EWRGS (Evidence-Weighted Research Gap Scoring) Algorithmic Weights
# -----------------
# Formula: EWRGS = w1*U + w2*T + w3*D + w4*L + w5*C
EWRGS_WEIGHT_UNDEREXPLORATION=0.30
EWRGS_WEIGHT_TREND=0.20
EWRGS_WEIGHT_DIVERSITY_DEFICIT=0.20
EWRGS_WEIGHT_LIMITATIONS=0.15
EWRGS_WEIGHT_CONFLICT=0.15

# -----------------
# Frontend Configuration
# -----------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="ResearchGraph AI"
